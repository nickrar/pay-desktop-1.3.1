{
  "name": "pay-desktop",
  "productName": "Pay",
  "version": "1.3.1",
  "description": "Pay. — Personal Finance & Daily Earning Tracker (desktop app)",
  "main": "main.js",
  "author": "Pay",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/finance-engine.test.js",
    "build:css": "tailwindcss -c tailwind.config.js -i src/input.css -o app/styles.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i src/input.css -o app/styles.css --watch",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^3.4.17"
  },
  "build": {
    "appId": "app.pay.finance",
    "productName": "Pay",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "app/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.finance",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "build/icon.png"
    }
  }
}
